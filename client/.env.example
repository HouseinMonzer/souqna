# Copy to client/.env.local. Only VITE_-prefixed values reach the browser —
# never put API secrets here.
VITE_API_URL=http://localhost:4000

# Shown to customers and vendors. Leave empty to hide; pages then point to the contact page.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_WHATSAPP=
# Where vendors send subscription payments
VITE_PAYMENT_WISH_NUMBER=
VITE_PAYMENT_OMT_DETAILS=
