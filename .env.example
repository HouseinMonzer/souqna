# ─── Server (Express + Prisma) ────────────────────────────────────────────────
# Copy to .env.local for local dev. In production set these in Railway.
# The server validates this file on startup (server/config/env.js) and refuses
# to boot in production if a required value is missing.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent  (default: info, silent in tests)
LOG_LEVEL=info
# Set to true on extra replicas or one-off processes to skip the hourly subscription job
DISABLE_JOBS=false

# Neon PostgreSQL — pooled URL for the app, direct URL for migrations
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Auth — generate each with: openssl rand -base64 48   (min 32 chars, required in prod)
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=

# Public URLs (required in prod). CLIENT_ORIGIN accepts a comma-separated allow-list;
# the first entry is used for OAuth redirects.
CLIENT_ORIGIN=http://localhost:5173
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# Image uploads — UploadThing (server-side only, never expose to the client)
UPLOADTHING_TOKEN=

# OAuth (optional — buttons fall back gracefully when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email (optional — falls back to an Ethereal test inbox when SMTP_HOST is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SouQna" <noreply@souqna.com>

# Demo accounts — only used by `npm run seed:demo`
DEMO_ACCOUNT_PASSWORD=
